* text=auto
.gitattributes text eol=lf
.gitignore text eol=lf

*.py text eol=lf
*.md text eol=lf
*.tex text eol=lf
*.bib text eol=lf
*.csv text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.cff text eol=lf
*.txt text eol=lf
*.sh text eol=lf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Preserve the official Elsevier vendor files without rewriting their spacing.
journal_submissions/**/elsarticle.cls text eol=lf whitespace=-blank-at-eol,-blank-at-eof
journal_submissions/**/elsarticle-harv.bst text eol=lf whitespace=-blank-at-eol,-blank-at-eof

*.jpg binary
*.JPG binary
*.png binary
*.pdf binary
*.pt binary
